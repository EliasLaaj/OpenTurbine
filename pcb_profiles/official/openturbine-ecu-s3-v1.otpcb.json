{
  "format": "openturbine-pcb-profile",
  "format_version": {"major": 1, "minor": 0},
  "board": {
    "id": "openturbine-ecu-s3-v1",
    "name": "OpenTurbine ECU",
    "revision": "1.0",
    "manufacturer": "OpenTurbine",
    "description": "Official ESP32-S3 OpenTurbine ECU board"
  },
  "target": {
    "chip": "esp32-s3",
    "minimum_flash_mb": 16,
    "reviewed_strapping_gpio": [3, 45]
  },
  "buses": [
    {"id": "sensor_i2c", "kind": "i2c", "pins": {"sda": 4, "scl": 5}, "frequency_hz": 400000},
    {"id": "thermocouple_spi", "kind": "spi", "pins": {"sck": 12, "miso": 13, "mosi": 11}},
    {"id": "serial_0", "kind": "uart", "pins": {"tx": 43, "rx": 44}}
  ],
  "devices": [
    {"id": "thermocouple_chip_1", "driver": "max31856", "bus": "thermocouple_spi", "select": {"gpio": 14}, "expected": true},
    {"id": "thermocouple_chip_2", "driver": "max31856", "bus": "thermocouple_spi", "select": {"gpio": 21}, "expected": true},
    {"id": "adc_chip", "driver": "tla2528", "bus": "sensor_i2c", "address": 16, "expected": true},
    {"id": "io_expander", "driver": "tca9554", "bus": "sensor_i2c", "address": 32, "expected": true}
  ],
  "fixed_functions": {
    "status_led": {"gpio": 45, "type": "gpio", "active_high": true, "safe_demand": 0},
    "servo_output_enable": {"gpio": 17, "active_high": false, "safe_demand": 0},
    "supply_voltage": {
      "gpio": 10,
      "divider": 18.6470588235,
      "reference_mv": 3300,
      "label": "ECU supply voltage"
    },
    "cluster_serial": {"bus": "serial_0"},
    "mavlink": {"bus": "serial_0"}
  },
  "ports": [
    {
      "id": "thermocouple_1", "label": "Thermocouple 1", "connector": "Thermocouple 1",
      "description": "Built-in MAX31856 thermocouple channel",
      "modes": [{"id": "temperature", "adapter": "spi_thermocouple", "device": "thermocouple_chip_1"}]
    },
    {
      "id": "thermocouple_2", "label": "Thermocouple 2", "connector": "Thermocouple 2",
      "description": "Built-in MAX31856 thermocouple channel",
      "modes": [{"id": "temperature", "adapter": "spi_thermocouple", "device": "thermocouple_chip_2"}]
    },

    {
      "id": "adc_1", "label": "ADC input 1", "connector": "ADC1 / CN24",
      "description": "0-5 V analog input; may also act as a voltage-threshold digital switch",
      "modes": [
        {"id": "analog", "adapter": "i2c_adc_input", "device": "adc_chip", "channel": 0, "reference_mv": 5000, "limits": {"minimum_mv": 0, "maximum_mv": 5000}},
        {"id": "digital", "adapter": "i2c_adc_digital_input", "device": "adc_chip", "channel": 0, "reference_mv": 5000}
      ]
    },
    {
