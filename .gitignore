# PlatformIO build directories
.pio
.pio2
.pio3

# VSCode generated files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Flash output logs (build artefacts)
flash_output.txt
flash_fw_output.txt
flash_fs_output.txt
flash_fw.log
*.log
.codex-*.err
dist/
tools/setup_tool/OpenTurbineSetupTool.exe

# Local hardware recovery snapshots created during bench qualification
.codex-hardware-backups/

# Local PCB-import inspection scratch (source design stays outside the repo)
.pcb-design-review/

# ESP32-S3 dynconfig module copied into project root for pioarduino toolchain lookup
xtensa_esp32s3.so
xtensa_esp32.so

# Node dependencies for the tools/ui_*.cjs browser audit scripts
node_modules/

# Python bytecode (tools/ and the dev/bench harness)
__pycache__/
*.pyc

# Bench campaign engine-file snapshots are local recovery artifacts. Curated
# qualification result JSON may still be committed from this directory.
dev/bench/results/*_backup_*.json

# Bench PCB binaries are regenerated from the adjacent JSON source profiles.
dev/bench/pcb_profiles/*.bin
